        "authorized": true,
        "resource": {
          "record_id": "record-001",
          "classification": "internal",
          "attributes": {
            "region": "us-west",
            "active": true
          }
        }
      },
      "expected": {
        "result": "READ_ONLY_PROJECTION_ALLOWED",
